{
  "info": {
    "name": "Sabor Gourmet - MVC y JPA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el servidor iniciado. Crea y elimina registros propios; no borra la semilla."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "mesaId",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    },
    {
      "key": "fechaReserva",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Registrar cliente de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cliente Postman\",\n  \"email\": \"postman+{{marca}}@example.test\",\n  \"telefono\": \"+56911112222\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const marca = Date.now(); pm.collectionVariables.set('marca', marca);",
              "pm.collectionVariables.set('numeroMesa', 100 + Math.floor(Math.random() * 9000));",
              "pm.collectionVariables.set('fechaReserva', new Date(Date.now() + 3*86400000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('clienteId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Registrar mesa de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/mesas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": {{numeroMesa}},\n  \"capacidad\": 4,\n  \"ubicacion\": \"Salón Postman\",\n  \"activa\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('mesaId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Consultar disponibilidad",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/mesas/disponibles?fecha={{fechaReserva}}&hora=13:00&personas=2&duracion=120"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Mesa de prueba disponible', () => pm.expect(pm.response.json().mesasDisponibles.some(m => String(m.id) === String(pm.collectionVariables.get('mesaId')))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Crear reserva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"mesaId\": {{mesaId}},\n  \"fecha\": \"{{fechaReserva}}\",\n  \"hora\": \"13:00\",\n  \"duracionMinutos\": 120,\n  \"cantidadPersonas\": 2,\n  \"observaciones\": \"Demostración API JPA\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('reservaId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Verificar conflicto de horario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"mesaId\": {{mesaId}},\n  \"fecha\": \"{{fechaReserva}}\",\n  \"hora\": \"13:00\",\n  \"duracionMinutos\": 120,\n  \"cantidadPersonas\": 2,\n  \"observaciones\": \"Demostración API JPA\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Modificar reserva",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas/{{reservaId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"mesaId\": {{mesaId}},\n  \"fecha\": \"{{fechaReserva}}\",\n  \"hora\": \"15:00\",\n  \"duracionMinutos\": 120,\n  \"cantidadPersonas\": 2,\n  \"observaciones\": \"Reserva modificada desde Postman\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Hora modificada',()=>pm.expect(pm.response.json().hora).to.eql('15:00'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Cancelar reserva",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas/{{reservaId}}/cancelar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Demostración completada\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Reserva cancelada',()=>pm.expect(pm.response.json().estado).to.eql('CANCELADA'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Comprobar mesa liberada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/mesas/disponibles?fecha={{fechaReserva}}&hora=15:00&personas=2&duracion=120"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Mesa disponible después de cancelar',()=>pm.expect(pm.response.json().mesasDisponibles.some(m=>String(m.id)===String(pm.collectionVariables.get('mesaId')))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Proteger historial del cliente",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Eliminar reserva de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/reservas/{{reservaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Eliminar mesa de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/mesas/{{mesaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Eliminar cliente de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Recurso inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservas/9223372036854775807"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Validación de datos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"email\": \"mal\",\n  \"telefono\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}